# ---- Database (Railway Postgres) ----
DATABASE_URL=postgres://user:pass@host:5432/railway

# ---- Where rendered files are written and served from ----
STORAGE_DIR=./storage
WORKER_PORT=8080
# Public URL of the worker service, used by the web app to link assets
WORKER_PUBLIC_URL=http://localhost:8080

# ---- Transcription: groq | mock ----
TRANSCRIBE_PROVIDER=mock
GROQ_API_KEY=
GROQ_WHISPER_MODEL=whisper-large-v3-turbo

# ---- Content generation: openrouter | mock ----
LLM_PROVIDER=mock
OPENROUTER_API_KEY=
OPENROUTER_MODEL=anthropic/claude-sonnet-4.5

# ---- Branding ----
BRAND_NAME=Beyond Sunday

CAPTION_FONT=DejaVu Sans
# fit = whole frame on a blurred backdrop (nobody gets cropped out) | crop = fills the screen
CLIP_LAYOUT=fit

# 1080 (default) or 720. 720 roughly halves render time.
CLIP_WIDTH=1080
# Jobs one worker runs at once.
WORKER_CONCURRENCY=3

# Source recordings are deleted this long after their clips are rendered.
SOURCE_RETENTION_HOURS=72
# Headroom kept free on the volume, in MB.
MIN_FREE_MB=1500

# Posting provider. Without it the app still makes everything; it just cannot post.
ZERNIO_API_KEY=
# Public URL of the web app, where a network sends the volunteer back after connecting.
APP_URL=

# Photographs for carousel slides: pollinations (free, no key) | openrouter | none
IMAGE_PROVIDER=pollinations
IMAGE_MODEL=
IMAGE_TIMEOUT_MS=120000
